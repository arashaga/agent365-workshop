# Copy to Agent_365/.env (git-ignored) and restart the notebook kernel after editing.
# Start with WORKSHOP_START_HERE.md; each guided notebook includes its own setup.
# LIVE_SETUP.md maps prerequisites and troubleshooting to the numbered notebooks.
# The guided sequence uses real services and ignores the LangGraph-only flags below.
# LangGraph-only flags remain for Agent_ID_LangGraph_MultiAgent.ipynb / lab_helpers.py.

# --- Tenant (all notebooks) and LangGraph setup app -----------------------------
A365_LIVE=true
A365_TENANT_ID=
A365_CLIENT_ID=

# LangGraph setup app-only mode. Leave empty for interactive setup sign-in.
# Never commit a real secret.
A365_CLIENT_SECRET=

# --- LangGraph-only live provisioning controls ---------------------------------
A365_ALLOW_WRITES=false
A365_OWNER_OBJECT_ID=
A365_DEMO_AGENT_IDENTITY_ID=
A365_DEMO_BLUEPRINT_OBJECT_ID=
A365_DEMO_BLUEPRINT_APP_ID=

# --- Real LLM (guided notebook 02/04; not needed for 00/01 permission checks) ---
# Uses Azure CLI sign-in. No API key is required.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- Shared child/blueprint identity for guided notebooks 00-04 ---
# Historical OBSERVABILITY names are also used by MCP; do not create another child.
# Agent 365 export (04) additionally needs registration/telemetry authorization.
# These are separate from the public-client Graph app above.
# Agent ID = registered instance CLIENT/app ID, not a service-principal object ID.
# Blueprint ID = its parent blueprint CLIENT/app ID.
# Only use a real credential held by that blueprint; do not paste it in the notebook.
A365_OBSERVABILITY_AGENT_ID=
A365_OBSERVABILITY_BLUEPRINT_ID=
A365_OBSERVABILITY_BLUEPRINT_SECRET=

# --- Protected MCP in guided notebook 01 onward (no Agent 365 telemetry license needed) ---
# Client/app ID of a separate single-tenant custom MCP API, with v2 access tokens.
MCP_WORKSHOP_API_ID=
# Client/app ID of a separate public browser app, NOT the agent or its blueprint.
# Register Mobile/desktop redirect http://localhost:8400; see notebook 03.
MCP_WORKSHOP_BROWSER_CLIENT_ID=

# --- Guided workshop 02/04: Azure Application Insights trace destination ---
# Copy from your Application Insights resource > Overview > Connection String.
# Azure CLI user needs Monitoring Metrics Publisher on that resource.
# This is separate from the agent's MCP/Agent 365 permissions.
APPLICATIONINSIGHTS_CONNECTION_STRING=
